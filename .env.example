# --- Database ---
POSTGRES_USER=sorazon
POSTGRES_PASSWORD=sviluppo

POSTGRES_DB=sorazon

# --- Segreti (li genera scripts/env.sh) ---
PAYLOAD_SECRET=cambiami
REVALIDATE_SECRET=cambiami
PAYLOAD_API_KEY=

# --- URL pubblici: quelli che vede il BROWSER ---
FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:3001

# --- Nomi host per il proxy (solo con il profilo "proxy") ---
# Per simulare la produzione: FRONTEND_PUBLIC_URL=https://sorazon.localhost
#                             BACKEND_PUBLIC_URL=https://cms.sorazon.localhost
FRONTEND_HOST=sorazon.localhost
BACKEND_HOST=cms.sorazon.localhost
