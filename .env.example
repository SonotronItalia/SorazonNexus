# --- Database ---
POSTGRES_USER=sorazon
POSTGRES_PASSWORD=sviluppo

POSTGRES_DB=sorazon

# --- Segreti (li genera scripts/env.sh) ---
PAYLOAD_SECRET=cambiami
# Segreto interno tra i server: avvisi di revalidazione e lettura delle bozze
REVALIDATE_SECRET=cambiami
# Segreto nell'URL di anteprima delle bozze (lo vedono gli editor)
PREVIEW_SECRET=cambiami

# --- Email (SMTP). Vuoto = le email finiscono nel log del backend ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Email di sistema del CMS (reset password, account)
EMAIL_FROM=it@sonotronitalia.com
# Destinatario e mittente predefiniti delle email dei moduli del sito
EMAIL_INFO=info@sonotronitalia.com

# --- URL pubblici: quelli che vede il BROWSER ---
FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:3001

# --- Nomi host per il proxy (solo con il profilo "proxy") ---
# Per simulare la produzione: FRONTEND_PUBLIC_URL=https://sorazon.localhost
#                             BACKEND_PUBLIC_URL=https://cms.sorazon.localhost
FRONTEND_HOST=sorazon.localhost
BACKEND_HOST=cms.sorazon.localhost
# Email per Let's Encrypt (avvisi di scadenza). Vuota o host locali: certificato provvisorio autofirmato
CERTBOT_EMAIL=

# --- Google (facoltativi): vuoti = nessun tag Google, nel banner dei cookie niente categoria ---
# Google Analytics 4 (categoria "Statistiche"): sostituire il segnaposto con l'ID vero,
# es. G-ABC123XYZ. Finché resta G-XXXXXXXXXX il sito lo ignora (nessun tag, nessuna categoria)
GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Ads, es. AW-123456789 (categoria "Marketing")
GOOGLE_ADS_ID=
