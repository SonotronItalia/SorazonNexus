# Sviluppo SENZA Docker (pnpm dev). Con Docker valgono le variabili del compose.
DATABASE_URL=postgres://sorazon:sviluppo@127.0.0.1:5432/sorazon
PAYLOAD_SECRET=cambiami
REVALIDATE_SECRET=cambiami

BACKEND_PUBLIC_URL=http://localhost:3001
FRONTEND_PUBLIC_URL=http://localhost:3000
FRONTEND_INTERNAL_URL=http://localhost:3000

# Utente amministratore creato da "make seed" (solo sviluppo). La password la genera scripts/env.sh
SEED_ADMIN_EMAIL=admin@sorazon.localhost
SEED_ADMIN_PASSWORD=cambiami
